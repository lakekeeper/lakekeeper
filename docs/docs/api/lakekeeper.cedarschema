namespace Lakekeeper {
  // ============================================================================
  // OVERVIEW
  // ============================================================================
  //
  // This schema defines the Cedar entities, attributes, and actions used by
  // Lakekeeper's authorization engine.  Cedar policies are evaluated against
  // this schema to decide whether a principal may perform an action on a
  // resource.
  //
  // Resource hierarchy
  // ------------------
  //   Server > Project > Warehouse > Namespace > Table
  //                                             > View
  //                                             > GenericTable
  //                                             > (nested Namespaces)
  //                    > Role
  //                    > Tag
  //
  // ENTITY REFERENCE SYNTAX
  // -----------------------
  // In Cedar policy rules entities are written as:
  //
  //   <Namespace>::<EntityType>::"<entity-id>"
  //
  // or, when already inside the `Lakekeeper` namespace:
  //
  //   <EntityType>::"<entity-id>"
  //
  // For example:
  //   Lakekeeper::Project::"my-project"
  //   Lakekeeper::User::"oidc~alice@example.com"
  //
  // ID FORMATS BY ENTITY TYPE
  // -------------------------
  // Each entity type uses a specific string format as its Cedar entity ID:
  //
  //   Server     UUID
  //              "6e64ed7d-ace0-4a0c-9242-25da8eb237f6"
  //
  //   Project    String (alphanumeric, hyphens, underscores)
  //              "my-project"
  //
  //   Warehouse  UUID
  //              "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9"
  //
  //   Namespace  UUID
  //              "01943e3d-43c5-7a4e-b6dd-a55c7796d9da"
  //
  //   Table      "<warehouse-UUID>/<table-UUID>"
  //              "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9/01943e3d-43c5-7a4e-b6dd-a66d8807eaeb"
  //
  //   View       "<warehouse-UUID>/<view-UUID>"
  //              "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9/01943e3d-43c5-7a4e-b6dd-a77e9918fbfc"
  //
  //   GenericTable  "<warehouse-UUID>/<generic-table-UUID>"
  //              "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9/01943e3d-43c5-7a4e-b6dd-a88faa29bcad"
  //
  //   Tag        UUID
  //              "01943e3d-43c5-7a4e-b6dd-a99f0029acbd"
  //
  //   User       "<provider_id>~<subject-in-provider>"
  //              "oidc~alice@example.com"
  //              "kubernetes~eb952f26-3a1a-4020-bcb4-3f7d43049284"
  //
  //   Role       "<project-id>/<provider_id>~<source_id>"
  //              "my-project/lakekeeper~01943e3d-43c5-7a4e-b6dd-a88f0029acbd"
  //              "my-project/oidc~data-engineers"
  //
  // ============================================================================
  // ENTITY TYPE DEFINITIONS
  // ============================================================================

  // ---------- Principals ----------

  // A user principal, typically derived from an authentication token.
  // ID: "<provider_id>~<subject-in-provider>"  e.g. "oidc~alice@example.com"
  //
  // USER ROLES
  // ----------
  // A user holds two kinds of role:
  //
  //   Groups           — from a directory (LDAP, Entra ID, Okta), from token
  //                      claims, or from an admission gate.
  //   Lakekeeper roles — roles managed in Lakekeeper (provider_id "lakekeeper",
  //                      created through the management API) and `system` roles.
  //
  // Name a group with the flat form. It works at every action:
  //
  //   principal.project_roles.contains({provider_id: "ldap", source_id: "contractors"})
  //
  // At server actions (every action on `Server`, user management included):
  //
  //   - the user carries their groups in `project_roles` and `global_role_ids`,
  //     the same for every `x-project-id`;
  //   - a Lakekeeper role counts through a server grant; see "Server Actions";
  //   - act as yourself: a request with `x-assume-role` is denied, except on
  //     your own user record, and so is a permission check about a role.
  //
  // At actions inside a project (project, warehouse and below), the user carries
  // every role they hold in that object's project, groups and Lakekeeper roles,
  // with every role those are nested in. `roles`, `principal in Role::"..."` and
  // `request_project` work at these actions only.
  //
  // When the server loads or reloads its policies, the server-action check reads
  // each policy that can decide a server action. It refuses a `forbid`, or a
  // `permit`'s exception, that names something no user has at server actions,
  // such as a `Role` id, a Lakekeeper role, `roles` or `request_project`,
  // because it would stop nobody there. The log names the policy and shows the
  // fix. A `permit` that requires such a name allows nobody at server actions.
  // It still loads: with a warning for a Lakekeeper role, `roles` or
  // `request_project`, and with no message for a group's `Role` id.
  //
  // With `LAKEKEEPER__CEDAR__EXTERNALLY_MANAGED_USER_AND_ROLES=true`, a user
  // carries the roles and parents your entities file declares, at every action.
  // The server-action check and the `x-assume-role` rule apply the same in
  // every mode.
  entity User in [Role, Server] {
    // Email of the user, extracted from the authentication token.
    // Not available for all token types.
    // NOT UNIQUE: Lakekeeper does not enforce email uniqueness. Two distinct
    // users may legitimately share an email (e.g. service principals using a
    // shared mailbox, or default emails issued by an IDP). Do not use `email`
    // as an identity discriminator in policies — use the entity UID
    // (`Lakekeeper::User::"<provider>~<source>"`) or `provider_id`/`source_id`.
    email?: String,
    // The user's roles as `Role` UIDs. Each is a parent of the user, so
    // `principal in Role::"<project-id>/<provider>~<source-id>"` matches. Holds
    // the user's roles in the object's project. Empty at server actions.
    roles: Set<Role>,
    // The user's roles as {provider_id, source_id} records. Match with
    // `.contains({provider_id: "ldap", source_id: "admins"})`. At server
    // actions: the user's groups. At actions inside a project: every role the
    // user holds in the object's project, Lakekeeper roles included.
    // A token role has the identity provider's id as `provider_id` (e.g. "oidc").
    // A request acting as a role has no `project_roles`: guard the read with
    // `principal is Lakekeeper::User`.
    project_roles: Set<{provider_id: String, source_id: String}>,
    // The `source_id` of each of the user's groups, as a plain Set<String>.
    // Lakekeeper roles are not in it.
    // Match with `principal.global_role_ids.contains("admins")`.
    // Filled only when `LAKEKEEPER__CEDAR__GLOBAL_ROLE_IDS_ENABLED=true`;
    // otherwise empty. Use it only when no two role providers share a
    // `source_id`; otherwise use `project_roles`.
    global_role_ids: Set<String>,
    // Authentication provider of the user (e.g. "oidc", "kubernetes", etc.)
    provider_id: String,
    // The ID of this user in its authentication provider
    source_id: String,
    // The project an action inside a project is decided in. Absent at server
    // actions. To keep a policy away from server actions, add
    // `!(resource is Lakekeeper::Server)` to its `when`. Use this condition, not a
    // `principal has request_project` test: the server-action check refuses a
    // `forbid` that reaches server actions with that test.
    request_project?: Project,
    // Derived identity attributes, populated from configured regex derivations.
    // Configured via `LAKEKEEPER__CEDAR__USER_DERIVATIONS`.
    // Each derivation matches a regex with named capture groups against a source
    // field (source_id, provider_id). Named groups become string tags on this
    // entity.
    //
    // Optional — only present when user derivations are configured.
    //
    // Access in policies (guard with has() since the field is optional):
    //   principal has derived_attributes &&
    //   principal.derived_attributes.hasTag("username") &&
    //   principal.derived_attributes.getTag("username")
    derived_attributes?: UserDerivedAttributes,
  };

  // Derived identity attributes for a User, populated from configurable regex
  // derivations (see `LAKEKEEPER__CEDAR__USER_DERIVATIONS`).
  // Tags are keyed by regex named capture group names with String values.
  // ID: same as the owning User entity ID (1:1 relationship).
  entity UserDerivedAttributes = {} tags String;

  // Roles in Lakekeeper are scoped to projects.
  // ID: "<project-id>/<provider_id>~<source_id>"
  //     e.g. "my-project/lakekeeper~01943e3d-43c5-7a4e-b6dd-a88f0029acbd"
  //          "my-project/oidc~data-engineers"
  //
  // A role nested in other roles has them as Cedar parents, so `in` means
  // membership: `principal in Role::"my-project/oidc~admins"` holds for a
  // caller acting as any role nested inside `admins`, at any depth. The same
  // applies to a role named as a grant's grantee, to the subject of an
  // introspection, and to the role named when assuming one. At server actions,
  // acting as a role or asking about one is denied; see `User`.
  entity Role in [Role, Project] = {
    project: Project,
    // Provider of this role (e.g. "oidc", "lakekeeper", etc.)
    provider_id: String,
    // The ID of this role in its provider
    source_id: String,
  };

  // ---------- Grants ----------
  //
  // Every object below carries one record naming the privileges the principal
  // being authorized holds, granted to them or to one of their roles:
  //
  //   principal_privileges.direct    — granted on this object.
  //   principal_privileges.inherited — granted on an object above it, up to the
  //                                    server.
  //
  // Read a field: `resource.principal_privileges.direct.select`. Every field is
  // always set; with no grants they are all false.
  //
  // The name says whose they are, because the position does not. The record
  // belongs to the request's `principal` wherever it is read — on the decided
  // resource, on an object above it, or on an object reached from the
  // principal's or a grantee's side. It is never that object's owner's, and
  // never the grantee's.
  //
  // Each level has its own record type below. Both `direct` and `inherited`
  // carry exactly the privileges grantable at that level, so an ancestor
  // privilege outside this level's vocabulary stays out of `inherited`.
  //
  // Three consequences worth knowing before writing a policy against
  // `inherited`:
  //   - `create` is grantable from the server down to a namespace but not on a
  //     table, view or generic table, so a warehouse-level `create` grant does
  //     not appear in a table's inherited record. Creating a table is authorized
  //     on its namespace, which is where that grant does appear.
  //   - `apply` is grantable only on a tag, and a tag's only ancestor is a
  //     project, so `Tag.principal_privileges.inherited.apply` is always false.
  //     Read `direct.apply` instead.
  //   - `manage_policies` is grantable on a project and a warehouse. A project's
  //     only ancestor is the server, so
  //     `Project.principal_privileges.inherited.manage_policies` is always
  //     false; a warehouse inherits it from its project as usual.
  //
  // What a privilege allows is decided by the policies you load: these fields
  // are an input to a policy, never a decision on their own.
  // `GET /management/v1/grants/grantable-privileges` describes each name.
  //
  // A request resolves the grants held on every object it places — the objects
  // it decides, each item of a batch included, their ancestors, and the objects
  // it reaches from the principal's or a grantee's side — so `false` means the
  // privilege is not held, wherever the record appears. An object supplied
  // through an external entity source is the exception: it carries whatever that
  // file declares.
  //
  // In a `forbid`, prefer attributes of `resource`: a forbid that reads another
  // entity is skipped when that entity is missing, and a skipped forbid lets the
  // request through.

  // Grantable on the server.
  type ServerPrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    create: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
  };

  // Grantable on a project.
  type ProjectPrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    create: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
    manage_policies: Bool,
  };

  // Grantable on a warehouse.
  type WarehousePrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    create: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
    manage_policies: Bool,
  };

  // Grantable on a namespace.
  type NamespacePrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    create: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
  };

  // Grantable on a table.
  type TablePrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
  };

  // Grantable on a view.
  type ViewPrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
  };

  // Grantable on a generic table.
  type GenericTablePrivileges = {
    describe: Bool,
    select: Bool,
    write: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
  };

  // Grantable on a tag definition.
  type TagPrivileges = {
    describe: Bool,
    apply: Bool,
    manage: Bool,
    pass_grants: Bool,
    manage_grants: Bool,
  };

  // What the principal being authorized holds at each level: on the object
  // itself, and on the objects above it. One pair per level, so each side
  // carries that level's vocabulary and nothing else.
  type ServerPrincipalPrivileges = {
    direct: ServerPrivileges,
    inherited: ServerPrivileges,
  };
  type ProjectPrincipalPrivileges = {
    direct: ProjectPrivileges,
    inherited: ProjectPrivileges,
  };
  type WarehousePrincipalPrivileges = {
    direct: WarehousePrivileges,
    inherited: WarehousePrivileges,
  };
  type NamespacePrincipalPrivileges = {
    direct: NamespacePrivileges,
    inherited: NamespacePrivileges,
  };
  type TablePrincipalPrivileges = {
    direct: TablePrivileges,
    inherited: TablePrivileges,
  };
  type ViewPrincipalPrivileges = {
    direct: ViewPrivileges,
    inherited: ViewPrivileges,
  };
  type GenericTablePrincipalPrivileges = {
    direct: GenericTablePrivileges,
    inherited: GenericTablePrivileges,
  };
  type TagPrincipalPrivileges = {
    direct: TagPrivileges,
    inherited: TagPrivileges,
  };

  // A governance-tag definition: a project-scoped vocabulary entry that can be
  // attached to warehouses, namespaces, tables, views, generic tables and columns.
  // ID: UUID  e.g. "01943e3d-43c5-7a4e-b6dd-a99f0029acbd"
  entity Tag in [Project] {
    project: Project,
    // Name of the tag definition (e.g. "pii.classification").
    name: String,
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: TagPrincipalPrivileges,
  };

  // ---------- Resource Hierarchy ----------
  // Server > Project > Warehouse > Namespace > Table / View / GenericTable

  // Server is the top-level administrative entity.
  // ID: UUID  e.g. "6e64ed7d-ace0-4a0c-9242-25da8eb237f6"
  entity Server {
    // What the principal being authorized holds here; see `Grants` above.
    // `inherited` is always all false: the server has nothing above it.
    principal_privileges: ServerPrincipalPrivileges,
  };

  // Project is a container for warehouses.
  // ID: String (alphanumeric, hyphens, underscores)  e.g. "my-project"
  entity Project in [Server] {
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: ProjectPrincipalPrivileges,
  };

  // Warehouse is a container for namespaces.
  // ID: UUID  e.g. "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9"
  entity Warehouse in [Project] {
    name: String,
    project: Project,
    // Whether the warehouse is switched on. A deactivated warehouse refuses
    // catalog requests; `ActivateWarehouse` switches it back on.
    is_active: Bool,
    // Whether this warehouse is protected against deletion. Deleting it needs
    // the protection cleared first, or `force` set on the request.
    protected: Bool,
    // Whether this warehouse has soft-deletion configured. When true, a `force`
    // drop bypasses the configured grace period and is irreversible immediately;
    // when false, drops are already hard deletes and `force` changes nothing.
    soft_delete_enabled: Bool,
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: WarehousePrincipalPrivileges,
    // Governance tags in effect here; see `ResourceTags`.
    governance_tags: ResourceTags,
  };

  // Namespace can be nested within other namespaces or directly within a warehouse.
  // ID: UUID  e.g. "01943e3d-43c5-7a4e-b6dd-a55c7796d9da"
  entity Namespace in [Namespace, Warehouse] {
    project: Project,
    warehouse: Warehouse,
    // Full name of the namespace including all UTF-8 characters.
    // Segments are separated by '.'.
    // Lakekeeper enforces that no segment contains '.'.
    name: String,
    // Whether this namespace is protected against deletion. Deleting or moving
    // it needs the protection cleared first, or `force` set on the request.
    protected: Bool,
    // Current properties of this namespace, reflecting the state before any
    // pending update. For properties being set during an update, see the
    // context of the UpdateNamespaceProperties action.
    properties: ResourceProperties,
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: NamespacePrincipalPrivileges,
    // Governance tags in effect here; see `ResourceTags`.
    governance_tags: ResourceTags,
  };

  // Table entity for Iceberg tables.
  // ID: "<warehouse-UUID>/<table-UUID>"
  //     e.g. "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9/01943e3d-43c5-7a4e-b6dd-a66d8807eaeb"
  entity Table in [Namespace] {
    project: Project,
    warehouse: Warehouse,
    // Direct parent namespace.
    namespace: Namespace,
    // Name of the table within its namespace.
    name: String,
    // Whether this table is protected against deletion. Dropping it needs the
    // protection cleared first, or `force` set on the request.
    protected: Bool,
    // Current properties of this table, reflecting the state before any
    // pending update. For properties being set during an update, see the
    // context of the CommitTable action.
    properties: ResourceProperties,
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: TablePrincipalPrivileges,
    // Governance tags in effect here; see `ResourceTags`.
    governance_tags: ResourceTags,
  };

  // View entity for Iceberg views.
  // ID: "<warehouse-UUID>/<view-UUID>"
  //     e.g. "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9/01943e3d-43c5-7a4e-b6dd-a77e9918fbfc"
  entity View in [Namespace] {
    project: Project,
    warehouse: Warehouse,
    // Direct parent namespace.
    namespace: Namespace,
    // Name of the view within its namespace.
    name: String,
    // Whether this view is protected against deletion. Dropping it needs the
    // protection cleared first, or `force` set on the request.
    protected: Bool,
    // Current properties of this view, reflecting the state before any
    // pending update. For properties being set during an update, see the
    // context of the CommitView action.
    properties: ResourceProperties,
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: ViewPrincipalPrivileges,
    // Governance tags in effect here; see `ResourceTags`.
    governance_tags: ResourceTags,
  };

  // GenericTable entity for non-Iceberg ("generic") tables.
  // ID: "<warehouse-UUID>/<generic-table-UUID>"
  //     e.g. "01943e3d-43c5-7a4e-b6dd-a44b6685c8c9/01943e3d-43c5-7a4e-b6dd-a88faa29bcad"
  entity GenericTable in [Namespace] {
    project: Project,
    warehouse: Warehouse,
    // Direct parent namespace.
    namespace: Namespace,
    // Name of the generic table within its namespace.
    name: String,
    // Whether this generic table is protected against deletion. Dropping it
    // needs the protection cleared first, or `force` set on the request.
    protected: Bool,
    // Current properties of this generic table.
    properties: ResourceProperties,
    // What the principal being authorized holds here and above; see `Grants`.
    principal_privileges: GenericTablePrincipalPrivileges,
    // Governance tags in effect here; see `ResourceTags`.
    governance_tags: ResourceTags,
  };

  // ---------- Resource Properties ----------

  // The key-value properties of a namespace, table, view or generic table.
  // Property keys are chosen by whoever writes the object (for example "owner"
  // or "classification"), so they are not known ahead of time and are held as
  // Cedar tags rather than as fields. Every value has the shape
  // `ResourcePropertyValue` below.
  //
  // Access in policies. Guard with `hasTag`, because any key may be missing:
  //   resource.properties.hasTag("owner") &&
  //   resource.properties.getTag("owner").raw == "data-eng"
  entity ResourceProperties = {} tags ResourcePropertyValue;

  // Value type for each entry in ResourceProperties.
  type ResourcePropertyValue = {
      // The original value of the property as a string, as stored in the
      // Table / View / Namespace properties.
      raw: String,
      // Roles parsed from the property value.
      // Provide roles using Cedar entity syntax:
      // "[Lakekeeper::Role::\"<project-id>/<provider>~<source-id>\"]"
      // Roles and Users can be mixed in a heterogeneous set.
      roles: Set<Role>,
      // Users parsed from the property value.
      // Provide users using Cedar entity syntax:
      // "[Lakekeeper::User::\"<user-id>\"]"
      // Roles and Users can be mixed in a heterogeneous set.
      users: Set<User>,
      // source_id of every role parsed from this property value, as plain strings.
      // Only populated when `LAKEKEEPER__CEDAR__GLOBAL_ROLE_IDS_ENABLED=true`.
      // Mirrors `User.global_role_ids` — enables simple policies like:
      //   resource.properties.getTag("access_read").global_role_ids.containsAny(principal.global_role_ids)
      // Prefer `roles` when provider uniqueness cannot be guaranteed.
      global_role_ids: Set<String>,
  };

  // ---------- Resource Tags ----------

  // The governance tags in effect on a warehouse, namespace, table, view or
  // generic table: its own, plus those inherited from the namespaces and the
  // warehouse above it. Where one tag is applied at several levels, the nearest
  // wins — the same set the management API returns with `?effective=true`.
  // Column tags are not included.
  //
  // Keys are the tag's name exactly as defined, case included: a tag named
  // `PII` matches `hasTag("PII")`, not `hasTag("pii")`. Renaming a tag changes
  // its key. Values keep their case too.
  //
  // Access in policies. Guard with `hasTag`, because any key may be missing:
  //   resource.governance_tags.hasTag("PII")
  //   resource.governance_tags.hasTag("sensitivity") &&
  //   resource.governance_tags.getTag("sensitivity").value == "restricted"
  entity ResourceTags = {} tags TagValue;

  // Value type for each entry in ResourceTags.
  type TagValue = {
      // The value in effect, exactly as applied. Empty for a marker tag, which
      // has no value; test those with `hasTag` alone.
      value: String,
      // Every value this tag has here or anywhere above, `""` for a marker. A
      // tag applied further down replaces `value` but cannot remove an entry
      // from this set, so use it when a lower level must not be able to weaken
      // a rule:
      //   resource.governance_tags.hasTag("sensitivity") &&
      //   resource.governance_tags.getTag("sensitivity").values.contains("restricted")
      values: Set<String>,
      // Whether `value` comes from a namespace or warehouse above rather than
      // from this object.
      inherited: Bool,
  };

  // ============================================================================
  // ACTION DEFINITIONS
  // ============================================================================

  // ---------- How action groups are named and nested ----------
  //
  // Actions are collected into groups so that a policy can name one group
  // instead of listing every action in it. Group names follow a few patterns:
  //
  //   <Level>Actions             everything you can do to an object at that
  //                              level. The levels are Server, Project, Role,
  //                              Tag, Warehouse, Namespace, Table, View and
  //                              GenericTable.
  //   <Level><Step>Actions       one step of that level's ladder — see below.
  //   GrantActions               grant administration, at every level.
  //   <Level>GrantActions        grant administration at one level.
  //   GrantReadActions           the read-only part of grant administration, at
  //                              every level.
  //   CedarPolicyActions         policy administration, at every level.
  //   <Level>CedarPolicyActions  policy administration at one level.
  //   CedarPolicyReadActions     the read-only part of policy administration, at
  //                              every level.
  //   DataPlaneActions           a flat marker for the actions that hand out data
  //                              or data-access credentials. It has no ladder and
  //                              no per-level parts.
  //
  // A `<Level>Actions` group covers what may be done to the object. Deciding who
  // else may act takes a grant-administration or a policy-administration group;
  // see "Grant Administration Actions" and "Cedar Policy Actions" near the end
  // of this file.
  //
  // Each level has a ladder that runs from the narrowest step to the widest.
  // Every ladder starts at Describe and ends at Modify:
  //
  //   Server, Project, Warehouse, Namespace   Describe < Create < Modify
  //   Table, View, GenericTable               Describe < Select < Write < Modify
  //   Tag                                     Describe < Apply < Modify
  //   Role                                    no ladder — name the actions
  //
  // Read the nesting from the policy side rather than from the `in [...]` list.
  // The declaration
  //
  //   action "ProjectDescribeActions" in ["ProjectCreateActions", ...];
  //
  // puts describing inside creating. So a policy on the wider group
  //
  //   permit (principal, action in Lakekeeper::Action::"ProjectModifyActions", resource)
  //
  // also allows every create action and every describe action. Permit the
  // narrowest group that covers what you mean to allow. A forbid works the same
  // way: forbidding `ProjectActions` forbids everything below it.
  //
  // Each block below names its own ladder in one line and points back here.

  // ---------- Server Actions ----------
  // Actions on the server: Describe < Create < Modify < ServerActions.
  // See "How action groups are named and nested" above for how to read this.
  //
  // At a server action a user carries their groups; see "USER ROLES" at `User`.
  //
  // Name a group with the flat form:
  //
  //   permit (
  //     principal is Lakekeeper::User,
  //     action in [Lakekeeper::Action::"ListUsers", Lakekeeper::Action::"UpdateUsers", Lakekeeper::Action::"DeleteUsers"],
  //     resource is Lakekeeper::Server
  //   )
  //   when { principal.project_roles.contains({provider_id: "ldap", source_id: "user-admins"}) };
  //
  // Give a Lakekeeper role access to server actions with a server grant: grant
  // the role a privilege on the server, and load these permits, one per
  // privilege. No predefined policy decides server actions, so a server grant
  // does nothing without them:
  //
  //   permit (principal, action in Lakekeeper::Action::"ServerDescribeActions", resource is Lakekeeper::Server)
  //   when { resource.principal_privileges.direct.describe };
  //
  //   permit (principal, action in Lakekeeper::Action::"ServerCreateActions", resource is Lakekeeper::Server)
  //   when { resource.principal_privileges.direct.create };
  //
  //   permit (principal, action in Lakekeeper::Action::"ServerModifyActions", resource is Lakekeeper::Server)
  //   when { resource.principal_privileges.direct.manage };
  //
  //   permit (principal, action in Lakekeeper::Action::"ServerGrantActions", resource is Lakekeeper::Server)
  //   when { resource.principal_privileges.direct.manage_grants };
  //
  // Every member of the role holds its grants, so whoever manages the role's
  // members decides who has them.
  //
  // A `forbid` on a group with an unconstrained `action` holds at every action,
  // server actions included, and also stops its members from assuming a role:
  //
  //   forbid (principal is Lakekeeper::User, action, resource)
  //   when { principal.project_roles.contains({provider_id: "ldap", source_id: "contractors"}) };
  //
  // A `forbid` on fewer actions should also name `AssumeRole`.
  //
  // To fix a `forbid` that names a group by its `Role` id, split it in two:
  // keep the original for actions inside projects, and add a copy for server
  // actions that uses the flat form. A `Role` id in the scope moves into the
  // `when`:
  //
  //   forbid (principal in Lakekeeper::Role::"my-project/ldap~contractors", action, resource)
  //   when { !(resource is Lakekeeper::Server) };
  //
  //   forbid (principal, action, resource is Lakekeeper::Server)
  //   when { (principal is Lakekeeper::User && principal.project_roles.contains({provider_id: "ldap", source_id: "contractors"})) };
  //
  // Split a `permit` whose exception names the group the same way: the copy
  // keeps the exception, the actions and the other conditions. If the group's
  // provider is no longer configured, the flat form matches nobody; name a group
  // the members still hold.
  //
  // A decision about another user — a grant's grantee, or the subject of a
  // permission check — sees that user's directory groups. With persisted token
  // roles it also sees the token groups last stored for them. Stored token
  // roles are a snapshot of the user's last token and go stale: to decide about
  // users who are not signed in, use a role provider (LDAP, Entra ID, Okta).
  // Admission groups come only with the user's own requests.
  action "ServerActions";
  action "ServerDescribeActions" in ["ServerActions", "ServerCreateActions", "ServerModifyActions"];
  action "ServerCreateActions" in ["ServerActions", "ServerModifyActions"];
  action "ServerModifyActions" in ["ServerActions"];
  // Read-only actions on the server itself.
  //
  //   ListUsers — list the users this server knows about.
  //
  // The server's Cedar policies are policy administration; see "Cedar Policy
  // Actions" below.
  action ListUsers in ["ServerDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Server]
    };
  // Changing the users this server knows about.
  //
  //   ProvisionUsers — create a user record in Lakekeeper, either through the
  //     API or the first time that user makes an authenticated request.
  //   UpdateUsers — change what Lakekeeper stores about a user.
  //   DeleteUsers — remove a user record.
  //
  // Every user can update and delete their own user record. The server allows
  // that before any policy is evaluated, so it needs no policy and holds under
  // a `forbid` on `UpdateUsers` or `DeleteUsers`.
  action UpdateUsers, DeleteUsers, ProvisionUsers in ["ServerModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Server]
    };
  action CreateProject in ["ServerCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Server],
      context: {
        // Name of the project being created. Absent when listing allowed actions
        // or when not specified via the check API.
        project_name?: String,
        // Externally provided project ID. Absent when listing allowed actions
        // or when not specified via the check API.
        project_id?: String,
      }
    };

  // ---------- Project Actions ----------
  // Actions on a project: Describe < Create < Modify < ProjectActions.
  // See "How action groups are named and nested" above for how to read this.
  action "ProjectActions";
  action "ProjectDescribeActions" in ["ProjectActions", "ProjectCreateActions", "ProjectModifyActions"];
  action "ProjectCreateActions" in ["ProjectActions", "ProjectModifyActions"];
  action "ProjectModifyActions" in ["ProjectActions"];
  // `IncludeProjectInList` is asked once for every project a list request
  // found, and decides whether that project shows up in the answer. Forbid it
  // to hide projects from listings while leaving access to them alone; forbid
  // `ListWarehouses` or another `ListX` action to deny the list request itself.
  // The same holds for `IncludeWarehouseInList`, `IncludeNamespaceInList`,
  // `IncludeTableInList`, `IncludeViewInList` and `IncludeGenericTableInList`.
  //
  // One exception: when the caller is allowed `ListEverythingInWarehouse` or
  // `ListEverythingInNamespace`, the per-item check below that point is not
  // asked at all and everything is listed.
  action GetProjectMetadata, ListWarehouses, IncludeProjectInList, ListRoles,
         SearchRoles, GetProjectEndpointStatistics, GetProjectTaskQueueConfig,
         GetProjectTasks, ListTags in ["ProjectDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };
  // `ReadUserRoleAssignments` lists the roles a user holds in this project, as
  // `GET /management/v1/user/{id}/roles` and `/roles/transitive` return them.
  // It is in no action group: a policy reaches it by naming it, or by leaving
  // `action` unconstrained. The predefined `describe`, `create`, `manage` and
  // `manage_grants` policies name it.
  //
  // Everyone can always read their own assignments. The server allows that
  // before any policy is evaluated, so it needs no policy and holds under a
  // `forbid` on this action.
  action ReadUserRoleAssignments
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };
  action DeleteProject, RenameProject,
         ModifyProjectTaskQueueConfig,
         ControlProjectTasks in ["ProjectModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };
  action CreateWarehouse in ["ProjectCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project],
      context: {
        // Name of the warehouse being created. Absent when listing allowed
        // actions or when not specified via the check API.
        warehouse_name?: String,
      }
    };
  // `ProjectCreateActions` is about creating places to put data: warehouses
  // here, and namespaces, tables and views further down. Creating roles and tag
  // definitions is not part of it — those shape how the project is governed
  // rather than what it stores, so they live in `ProjectModifyActions` with the
  // other administrative actions.
  //
  // If you want someone to create tags or roles without handing them the whole
  // of `ProjectModifyActions`, permit the individual action instead.
  action CreateRole in ["ProjectModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project],
      context: {
        // Name of the role being created. Absent when listing allowed actions
        // or when not specified via the check API.
        role_name?: String,
        // The provider and source id the request binds the new role to. Both
        // are present or both absent; absent, the role is created in the
        // `lakekeeper` provider with its own id as source id. Read them
        // together: the same source id can exist in several providers.
        requested_provider_id?: String,
        requested_source_id?: String,
      }
    };
  action CreateTag in ["ProjectModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project],
      context: {
        // Name of the tag definition being created. Absent when listing allowed
        // actions or when not specified via the check API.
        tag_name?: String,
      }
    };

  // ---------- Role Actions ----------
  // Actions on a role. Roles have no ladder: `RoleActions` is the only group,
  // so there is no `RoleDescribeActions` to look for. To let someone read a
  // role without changing it, name the actions you mean.
  action "RoleActions";

  // Asking what another principal may do on a role is grant introspection, not
  // a role action: it belongs to `GrantReadActions` (there is no
  // `RoleGrantActions`), so a forbid on `GrantActions` covers it too.
  action IntrospectRoleAuthorization in ["GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Role]
    };

  // Reading and changing a role itself.
  //
  //   AssumeRole — act as this role for the request. The request is then decided
  //     as if the role made it, so the caller gets everything the role holds,
  //     including what the roles nested inside it hold. This is the one action
  //     that changes who the caller is, so permit it narrowly.
  //   ReadRole — read the role, including who its members are.
  //   ReadRoleMetadata — read only the role's name and the project it lives in.
  //     Used when assignments are listed across projects.
  //   UpdateRole — change the role's name or description.
  //   DeleteRole — remove the role.
  action AssumeRole, DeleteRole, UpdateRole, ReadRole, ReadRoleMetadata in ["RoleActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Role]
    };
  // Role-membership (assignment) actions, gating the role-membership management
  // API. Roles may have both users and other roles as members (recursive roles).
  //   ManageRoleAssignments — add/remove members (user or role) of this role.
  //   ReadRoleAssignments   — list this role's members, parents and assignments.
  action ManageRoleAssignments, ReadRoleAssignments in ["RoleActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Role]
    };
  // UpdateRoleSourceSystem — change this role's source id. The management API
  // rebinds only roles managed in Lakekeeper, onto the `lakekeeper` provider.
  // The requested provider and source id arrive as context, so policies can
  // gate them (e.g. forbid a source id another team's policies name). Context is
  // absent when listing allowed actions.
  action UpdateRoleSourceSystem in ["RoleActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Role],
      context: {
        requested_provider_id?: String,
        requested_source_id?: String,
      }
    };

  // ---------- Tag Actions ----------
  // Actions on a governance-tag definition.
  //   ReadTag            — read a tag definition (name, value kind, allowed values).
  //   UpdateTag          — update a tag definition (rename, widen scope, add values).
  //   DeleteTag          — delete a tag definition.
  //   ApplyTag           — attach this tag to a target; see the note below.
  //   RemoveTag          — detach this tag from a target; see the note below.
  //   ReadTagAttachments      — list every target a tag definition is attached to (reverse lookup).
  //   IntrospectTagAuthorization — inspect another principal's access to this tag.
  //
  // Actions on a tag definition: Describe < Apply < Modify < TagActions.
  // See "How action groups are named and nested" above for how to read this.
  action "TagActions";
  action "TagDescribeActions" in ["TagActions", "TagApplyActions", "TagModifyActions"];
  action "TagApplyActions" in ["TagActions", "TagModifyActions"];
  action "TagModifyActions" in ["TagActions"];
  action ReadTag in ["TagDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Tag]
    };
  // Attaching and detaching a tag uses the definition rather than changing it,
  // so these have their own group. That lets you give someone the right to
  // classify objects without also letting them rename or delete the tag.
  //
  // Attaching or detaching needs two permits: `ApplyTag` or `RemoveTag` on the
  // tag, and the target's own tag action — `ManageWarehouseTags`,
  // `ManageNamespaceTags`, `ManageTableTags`, `ManageViewTags` or
  // `ManageGenericTableTags` — on the object the tag goes on. The server
  // requires both. This schema cannot express the pairing, so permitting only
  // one of the two is not enough.
  action ApplyTag, RemoveTag in ["TagApplyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Tag]
    };
  // `ReadTagAttachments` sits here rather than with the read actions because it
  // lists every object a tag is attached to. That says a good deal more about
  // what is in the catalog than reading the tag's own definition does.
  action UpdateTag, DeleteTag, ReadTagAttachments in ["TagModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Tag]
    };

  // ---------- Warehouse Actions ----------
  // Actions on a warehouse: Describe < Create < Modify < WarehouseActions.
  // See "How action groups are named and nested" above for how to read this.
  action "WarehouseActions";
  action "WarehouseDescribeActions" in ["WarehouseActions", "WarehouseCreateActions", "WarehouseModifyActions"];
  action "WarehouseCreateActions" in ["WarehouseActions", "WarehouseModifyActions"];
  action "WarehouseModifyActions" in ["WarehouseActions"];
  //   UseWarehouse — reach the warehouse at all. Every request against the
  //     warehouse is checked for this first, so forbidding it hides the
  //     warehouse completely: requests are answered as if it were not there.
  //   GetConfig — read the Iceberg REST config endpoint that clients call when
  //     they connect.
  //   ListEverythingInWarehouse — see everything under the warehouse in
  //     listings. When this is allowed, everything below the warehouse is listed
  //     and the per-item `IncludeXInList` check is skipped.
  action UseWarehouse, ListNamespacesInWarehouse, GetWarehouseMetadata, GetConfig,
         IncludeWarehouseInList, ListDeletedTabulars, GetTaskQueueConfig, GetAllTasks,
         ListEverythingInWarehouse, GetWarehouseEndpointStatistics in ["WarehouseDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse]
    };
  action DeleteWarehouse, UpdateStorage, UpdateStorageCredential,
         DeactivateWarehouse, ActivateWarehouse,
         RenameWarehouse, ModifySoftDeletion,
         ModifyTaskQueueConfig, ControlAllTasks, SetWarehouseProtection,
         SetWarehouseFormatVersionPolicy, ManageWarehouseTags in ["WarehouseModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse]
    };
  action CreateNamespaceInWarehouse in ["WarehouseCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse],
      context: {
        // Name of the namespace being created. Absent when listing allowed
        // actions or when not specified via the check API.
        namespace_name?: String,
        // Initial property values for the namespace being created.
        initial_namespace_properties: ResourceProperties,
      }
    };
  // Accepting a namespace moved in from elsewhere, as a child of the warehouse
  // root. Distinct from creating one: a create adds an *empty* child, while a
  // move arrives carrying existing contents and the grants held on them, which
  // this warehouse's grantees can then read. Authorized alongside
  // `CreateNamespaceInWarehouse`, so a policy must allow both to admit a move.
  //
  // Like `MoveNamespace`, this action is in no group at all — accepting a
  // subtree changes what that subtree inherits, so a permit on
  // `WarehouseCreateActions` does not cover it. Name
  // `AcceptMovedNamespaceInWarehouse` in the policy.
  action AcceptMovedNamespaceInWarehouse
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse],
      context: {
        // Full path the namespace is moving from, as it stands before the move.
        // Dotted, as in `Namespace.name`.
        source: String,
      }
    };

  // ---------- Namespace Actions ----------
  // Actions on a namespace: Describe < Create < Modify < NamespaceActions.
  // See "How action groups are named and nested" above for how to read this.
  action "NamespaceActions";
  action "NamespaceDescribeActions" in ["NamespaceActions", "NamespaceCreateActions", "NamespaceModifyActions"];
  action "NamespaceCreateActions" in ["NamespaceActions", "NamespaceModifyActions"];
  action "NamespaceModifyActions" in ["NamespaceActions"];

  action ListEverythingInNamespace, GetNamespaceMetadata, IncludeNamespaceInList,
         ListTables, ListViews, ListGenericTables,
         ListNamespacesInNamespace in ["NamespaceDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace]
    };
  action SetNamespaceProtection, ManageNamespaceTags in ["NamespaceModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace]
    };
  // Moving a namespace to a new path — re-parenting, renaming, or both. Only the
  // source half of a move: the destination is authorized separately as
  // `CreateNamespaceIn{Namespace,Warehouse}` plus
  // `AcceptMovedNamespaceIn{Namespace,Warehouse}` on the parent it arrives under,
  // so a policy allowing a move out does not by itself allow the move in.
  //
  // Re-parenting changes what the namespace's contents inherit — the destination
  // subtree's grants start applying and the old parent's stop — without a grant
  // record changing anywhere. A move is therefore an act of grant administration
  // as much as of modification and belongs to no group: to allow it, a policy
  // must name `MoveNamespace` explicitly. Policies that care about where data
  // may live should read `destination`.
  action MoveNamespace
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Full destination path, including the new leaf name. Dotted, as in
        // `Namespace.name`, so `like "prod.*"` matches a destination subtree.
        destination: String,
        // Whether the namespace is moved even though it is protected against
        // deletion. The protection itself stays set. `force` on
        // `DeleteNamespace` means more than this — see there.
        force: Bool,
      }
    };
  // The destination half; see `AcceptMovedNamespaceInWarehouse`. Outside
  // `NamespaceCreateActions` for the reason `MoveNamespace` is outside
  // `NamespaceModifyActions`: accepting a subtree changes what it inherits.
  action AcceptMovedNamespaceInNamespace
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Full path the namespace is moving from, as it stands before the move.
        // Dotted, as in `Namespace.name`.
        source: String,
      }
    };
  action DeleteNamespace in ["NamespaceModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Two effects at once. It deletes even though this namespace, a child
        // namespace, or a table or view inside it is protected against
        // deletion. And where the warehouse has soft-deletion configured, the
        // deletion is immediate and permanent.
        force: Bool,
        // Whether the underlying data/metadata files are physically purged.
        purge: Bool,
        // Whether the drop recurses into child namespaces, tables and views,
        // deleting the entire subtree rooted at this namespace.
        recursive: Bool,
      }
    };
  action CreateTable in ["NamespaceCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Name of the table being created. Absent when listing allowed actions
        // or when not specified via the check API.
        table_name?: String,
        // Externally provided table ID (e.g. via register). Absent when listing
        // allowed actions or when not specified via the check API.
        table_id?: String,
        // Initial property values for the table being created.
        initial_table_properties: ResourceProperties,
      }
    };
  action CreateView in ["NamespaceCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Name of the view being created. Absent when listing allowed actions
        // or when not specified via the check API.
        view_name?: String,
        // Initial property values for the view being created.
        initial_view_properties: ResourceProperties,
      }
    };
  action CreateGenericTableInNamespace in ["NamespaceCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Name of the generic table being created. Absent when listing allowed
        // actions or when not specified via the check API.
        generic_table_name?: String,
        // Externally provided generic table ID. Absent when listing allowed
        // actions or when not specified via the check API.
        generic_table_id?: String,
        // Generic table format (e.g. "lance", "delta"). Absent when listing
        // allowed actions or when not specified via the check API.
        format?: String,
        // User-supplied base location override. Absent when listing allowed
        // actions or when not specified via the check API.
        base_location?: String,
        // Initial property values for the generic table being created.
        initial_generic_table_properties: ResourceProperties,
      }
    };
  action CreateNamespaceInNamespace in ["NamespaceCreateActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Name of the namespace being created. Absent when listing allowed
        // actions or when not specified via the check API.
        namespace_name?: String,
        // Initial property values for the namespace being created.
        initial_namespace_properties: ResourceProperties,
      }
    };
  action UpdateNamespaceProperties in ["NamespaceModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Property values to be added or updated on this namespace.
        namespace_properties_updates: ResourceProperties,
        // Property keys to be removed from this namespace.
        namespace_properties_removal: Set<String>,
      }
    };

  // ---------- Table Actions ----------
  // Actions on a table: Describe < Select < Write < Modify < TableActions.
  // See "How action groups are named and nested" above for how to read this.
  action "TableActions";
  action "TableDescribeActions" in ["TableActions", "TableSelectActions", "TableWriteActions", "TableModifyActions"];
  action "TableSelectActions" in ["TableActions", "TableWriteActions", "TableModifyActions"];
  action "TableWriteActions" in ["TableActions", "TableModifyActions"];
  action "TableModifyActions" in ["TableActions"];
  // An action is in `DataPlaneActions` exactly when it vends data access or
  // data-access credentials: reading or writing table data, selecting a view.
  // Metadata writes — commits included — are not data-plane. A single forbid
  // on this group keeps a principal away from the data itself while leaving
  // their metadata access untouched.
  action "DataPlaneActions";
  action GetTableMetadata, IncludeTableInList, GetTableTasks in ["TableDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table]
    };
  action ReadTableData in ["TableSelectActions", "DataPlaneActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table]
    };
  // Writing to the table: getting write credentials, and committing the change.
  // These are kept apart from `TableModifyActions` so you can let a loading job
  // write data without also letting it drop, rename or unprotect the table.
  //
  // Committing covers schema changes too — a writer that adds a column is doing
  // its ordinary job. Policies cannot tell the two apart, so if you need to
  // stop schema changes in particular, stop them in the query engine that
  // sends the commit — this schema cannot express it.
  //
  // `WriteTableData` is also in `DataPlaneActions`: it vends data-access
  // credentials. `CommitTable` is not — a commit is a metadata write and never
  // hands out data access.
  action WriteTableData in ["TableWriteActions", "DataPlaneActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table]
    };
  action RenameTable,
         UndropTable, ControlTableTasks,
         SetTableProtection, ManageTableTags in ["TableModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table]
    };
  action DropTable in ["TableModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table],
      context: {
        // Two effects at once. It drops the table even though it is protected
        // against deletion. And where the warehouse has soft-deletion
        // configured, the drop is immediate and permanent.
        force: Bool,
        // Whether the underlying data files are physically purged from storage.
        purge: Bool,
      }
    };
  action CommitTable in ["TableWriteActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table],
      context: {
        // Property values to be added or updated on this table.
        table_properties_updates: ResourceProperties,
        // Property keys to be removed from this table.
        table_properties_removal: Set<String>,
      }
    };

  // ---------- View Actions ----------
  // Actions on a view: Describe < Select < Write < Modify < ViewActions.
  // See "How action groups are named and nested" above for how to read this.
  action "ViewActions";
  action "ViewDescribeActions" in ["ViewActions", "ViewSelectActions", "ViewWriteActions", "ViewModifyActions"];
  action "ViewSelectActions" in ["ViewActions", "ViewWriteActions", "ViewModifyActions"];
  action "ViewWriteActions" in ["ViewActions", "ViewModifyActions"];
  action "ViewModifyActions" in ["ViewActions"];
  action GetViewMetadata, IncludeViewInList, GetViewTasks in ["ViewDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View]
    };
  action SelectView in ["ViewSelectActions", "DataPlaneActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View]
    };
  action RenameView, UndropView,
         ControlViewTasks, SetViewProtection, ManageViewTags in ["ViewModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View]
    };
  action DropView in ["ViewModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View],
      context: {
        // Two effects at once. It drops the view even though it is protected
        // against deletion. And where the warehouse has soft-deletion
        // configured, the drop is immediate and permanent.
        force: Bool,
        // Whether the underlying metadata files are physically purged from storage.
        purge: Bool,
      }
    };
  // Committing a new version of the view's definition. Kept apart from
  // `ViewModifyActions` so someone can maintain the view's query without also
  // being able to drop, rename or unprotect it.
  action CommitView in ["ViewWriteActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View],
      context: {
        // Property values to be added or updated on this view.
        view_properties_updates: ResourceProperties,
        // Property keys to be removed from this view.
        view_properties_removal: Set<String>,
      }
    };

  // ---------- Generic Table Actions ----------
  // Actions on a generic table:
  // Describe < Select < Write < Modify < GenericTableActions.
  // See "How action groups are named and nested" above for how to read this.
  action "GenericTableActions";
  action "GenericTableDescribeActions" in ["GenericTableActions", "GenericTableSelectActions", "GenericTableWriteActions", "GenericTableModifyActions"];
  action "GenericTableSelectActions" in ["GenericTableActions", "GenericTableWriteActions", "GenericTableModifyActions"];
  action "GenericTableWriteActions" in ["GenericTableActions", "GenericTableModifyActions"];
  action "GenericTableModifyActions" in ["GenericTableActions"];
  action GetGenericTableMetadata, IncludeGenericTableInList,
         GetGenericTableTasks in ["GenericTableDescribeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [GenericTable]
    };
  action ReadGenericTableData in ["GenericTableSelectActions", "DataPlaneActions"]
    appliesTo {
      principal: [User, Role],
      resource: [GenericTable]
    };
  // Getting write credentials for the generic table. Kept apart from
  // `GenericTableModifyActions` so a loading job can write data without also
  // being able to drop, rename or unprotect it. Also in `DataPlaneActions`:
  // it vends data-access credentials.
  action WriteGenericTableData in ["GenericTableWriteActions", "DataPlaneActions"]
    appliesTo {
      principal: [User, Role],
      resource: [GenericTable]
    };
  action DropGenericTable,
         RenameGenericTable, UndropGenericTable, ControlGenericTableTasks,
         SetGenericTableProtection, ManageGenericTableTags in ["GenericTableModifyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [GenericTable]
    };

  // ---------- Grant Administration Actions ----------
  // A grant is a direct (principal, privilege, resource) permission, managed
  // through the grants API rather than written as a policy. These actions
  // control who may hand those permissions out.
  //
  //   GrantActions      — every grant-administration action, on every level.
  //   GrantReadActions  — the read-only subset, across every level.
  //   XGrantActions     — reading and managing grants on one level.
  //
  // The whole-subtree operations have their own groups, described under
  // "Subtree Grant Administration" at the end of this section.
  //
  // Each level's grant group belongs to `GrantActions` alone — not to that level's
  // `XActions` umbrella, nor to its `XModifyActions` group. So neither
  // `action in "WarehouseActions"` nor `action in "WarehouseModifyActions"` includes
  // grant administration; name a grant group or a single action. The note just
  // above the `GrantActions` declaration below explains why.
  //
  // To keep grant administration with one team, a single forbid covers every
  // level, and a forbid always wins over a permit:
  //
  //   forbid (principal, action in Lakekeeper::Action::"GrantActions", resource)
  //   unless {
  //     principal is Lakekeeper::User &&
  //     principal.project_roles.contains({provider_id: "oidc", source_id: "security"})
  //   };
  //
  // The team acts as themselves: a request with `x-assume-role` is covered by
  // this `forbid`.
  //
  //   ManageXGrants — grant and revoke privileges on X. Each privilege is
  //                   authorized on its own, even when one request covers
  //                   several, and `context.privilege` always holds the one
  //                   being decided:
  //
  //                     when {
  //                       context.privilege == Lakekeeper::TablePrivilege::"select"
  //                     }
  //
  //                   on `ManageTableGrants` delegates exactly `select`. Each
  //                   resource type has its own privilege type; a permit with
  //                   no privilege condition covers every privilege.
  //
  //                   `grantee` and `direction` say who would receive the
  //                   privilege and which way it is moving. See the `Grantee`
  //                   and `GrantDirection` types below.
  //
  //                   The API that lists which privileges you may administer
  //                   here asks "may I grant this?" — direction `"grant"`, no
  //                   grantee. A policy testing the grantee evaluates false
  //                   against that question, so read the list as a guide: every
  //                   grant is authorized again as it is applied.
  //   IntrospectXAuthorization — ask what another principal may do on X.
  //   ReadXGrants   — see who holds grants on X. The server also treats this as
  //                   making X itself visible to you, with no separate read
  //                   permission needed. That is enforced by the server, not by
  //                   this schema, so keep it in mind when you work out who can
  //                   see what.
  //                   `XGrantActions` covers this alongside ManageXGrants.
  // Who a grant would go to, or be taken away from.
  //
  // One of the two is set: `user` when the grant names a user, `role` when it
  // names a role. Neither is set when the question names nobody — when the API
  // asks which privileges you could grant here to anyone, and when a revoke
  // names a role this server has no record of.
  //
  // Check that the one you want is present before reading it. Cedar's strict
  // validation requires this, and it is also what keeps a policy written for a
  // particular grantee from firing on a question that names none:
  //
  //   when {
  //     context.grantee has role &&
  //     context.grantee.role == Lakekeeper::Role::"my-project/oidc~analysts"
  //   }
  //
  // `==` names that one role. `in` also covers the roles nested inside it:
  //
  //   context.grantee.role in Lakekeeper::Role::"my-project/oidc~analysts"
  //
  // matches a grant to `analysts` and to every role that is a member of it, at
  // any depth. Pick whichever you mean. For a Lakekeeper role, whoever manages
  // its members decides which roles `in` covers.
  type Grantee = {
    user?: User,
    role?: Role,
  };

  // Which way a grant is moving: `"grant"` when a privilege is being handed
  // out, `"revoke"` when it is being taken away.
  //
  //   when { context.direction == Lakekeeper::GrantDirection::"revoke" }
  entity GrantDirection enum ["grant", "revoke"];

  // The privilege a grant question is about, one type per resource type.
  //
  // `"unknown"` stands for a name this server does not define. It arrives when
  // revoking a grant recorded under a different authorizer, or under a
  // privilege a later release removed, so those rows stay revocable. No
  // principal holds it.
  entity ServerPrivilege enum
    ["describe", "select", "write", "create", "manage",
     "pass_grants", "manage_grants", "unknown"];
  entity ProjectPrivilege enum
    ["describe", "select", "write", "create", "manage", "manage_policies",
     "pass_grants", "manage_grants", "unknown"];
  entity WarehousePrivilege enum
    ["describe", "select", "write", "create", "manage", "manage_policies",
     "pass_grants", "manage_grants", "unknown"];
  entity NamespacePrivilege enum
    ["describe", "select", "write", "create", "manage",
     "pass_grants", "manage_grants", "unknown"];
  entity TablePrivilege enum
    ["describe", "select", "write", "manage",
     "pass_grants", "manage_grants", "unknown"];
  entity ViewPrivilege enum
    ["describe", "select", "write", "manage",
     "pass_grants", "manage_grants", "unknown"];
  entity GenericTablePrivilege enum
    ["describe", "select", "write", "manage",
     "pass_grants", "manage_grants", "unknown"];
  entity TagPrivilege enum
    ["describe", "apply", "manage",
     "pass_grants", "manage_grants", "unknown"];

  // Grant administration stands outside the per-resource `<X>Actions` groups on
  // purpose. Those groups mean "everything you can do to this object" — a policy
  // written against one of them never hands out the right to give others access.
  // Deciding who else gets access is opt-in: name `GrantActions`, one of the
  // per-level `<X>GrantActions`, or a leaf action.
  action "GrantActions";
  action "GrantReadActions" in ["GrantActions"];

  action "ServerGrantActions" in ["GrantActions"];
  action ManageServerGrants in ["ServerGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Server],
      context: {
        // The privilege being granted or revoked, one at a time even when the
        // request covers several. See the section comment above.
        privilege: ServerPrivilege,
        // Who would gain the privilege, or lose it on a revoke. Empty when the
        // question names no grantee.
        grantee: Grantee,
        // Which way the privilege is moving.
        direction: GrantDirection,
      }
    };
  action ReadServerGrants, IntrospectServerAuthorization in ["ServerGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Server]
    };

  action "ProjectGrantActions" in ["GrantActions"];
  action ManageProjectGrants in ["ProjectGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: ProjectPrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadProjectGrants, IntrospectProjectAuthorization in ["ProjectGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };

  action "WarehouseGrantActions" in ["GrantActions"];
  action ManageWarehouseGrants in ["WarehouseGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: WarehousePrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadWarehouseGrants, IntrospectWarehouseAuthorization in ["WarehouseGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse]
    };

  action "NamespaceGrantActions" in ["GrantActions"];
  action ManageNamespaceGrants in ["NamespaceGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: NamespacePrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadNamespaceGrants, IntrospectNamespaceAuthorization in ["NamespaceGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace]
    };

  action "TableGrantActions" in ["GrantActions"];
  action ManageTableGrants in ["TableGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: TablePrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadTableGrants, IntrospectTableAuthorization in ["TableGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Table]
    };

  action "ViewGrantActions" in ["GrantActions"];
  action ManageViewGrants in ["ViewGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: ViewPrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadViewGrants, IntrospectViewAuthorization in ["ViewGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [View]
    };

  action "GenericTableGrantActions" in ["GrantActions"];
  action ManageGenericTableGrants in ["GenericTableGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [GenericTable],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: GenericTablePrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadGenericTableGrants, IntrospectGenericTableAuthorization in ["GenericTableGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [GenericTable]
    };

  action "TagGrantActions" in ["GrantActions"];
  action ManageTagGrants in ["TagGrantActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Tag],
      context: {
        // Same three terms as ManageServerGrants; see the section comment.
        privilege: TagPrivilege,
        grantee: Grantee,
        direction: GrantDirection,
      }
    };
  action ReadTagGrants, IntrospectTagAuthorization in ["TagGrantActions", "GrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Tag]
    };

  // ---------- Subtree Grant Administration ----------
  // Two operations act on a whole subtree at once: listing every grant held at and
  // under a warehouse or namespace, and revoking those grants in bulk. A bulk
  // revoke is permanent.
  //
  //   ReadWarehouseSubtreeGrants   — list every grant in a warehouse's subtree.
  //   RevokeWarehouseSubtreeGrants — revoke them.
  //   ReadNamespaceSubtreeGrants   — list every grant in a namespace's subtree.
  //   RevokeNamespaceSubtreeGrants — revoke them.
  //
  //   SubtreeGrantActions       — all four.
  //   SubtreeGrantReadActions   — the two listing actions.
  //   SubtreeGrantRevokeActions — the two revoking actions.
  //
  // Both sit under `GrantActions`, the listing half also under
  // `GrantReadActions`, and both stand outside `WarehouseGrantActions` and
  // `NamespaceGrantActions`: authority over everything beneath an object is
  // handed out on its own. A rule aimed at one of those two level groups does not
  // reach these four actions. Aim at `GrantActions` to cover grant administration
  // whole, or at the subtree groups to cover just these. A rule that permits either
  // of those two wider groups therefore permits whole-subtree listing, and
  // `GrantActions` permits bulk revoke with it.
  //
  // Like `ReadXGrants`, the two listing actions also make the root itself visible,
  // with no separate read permission needed. That is enforced by the server, not by
  // this schema, so a `forbid` hiding a warehouse or namespace does not hide it from
  // someone who may list its subtree grants.
  //
  // The root is the warehouse or namespace the call names, and the whole subtree is
  // one decision. The server asks once, on the root, and then acts on every grant
  // beneath it. A policy on anything inside that subtree is never consulted, so a
  // `forbid` there leaves the operation untouched.
  //
  // `resource` is that root, and a rule cannot look from it down into the subtree.
  // The objects beneath the root take no part in the decision, so a condition that
  // asks whether one of them is in reach reads false rather than matching:
  //
  //   // Does NOT protect that namespace from a call rooted above it.
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantActions", resource)
  //   when { Lakekeeper::Namespace::"<id>" in resource };
  //
  // That rule is accepted, and it denies a call rooted at the namespace itself, so
  // it looks like it works. A call rooted at the warehouse above is allowed.
  //
  // A rule here names roots, so it protects at warehouse and namespace granularity.
  // A single table cannot be named: no subtree action takes a table as its resource.
  // A rule whose condition rests on naming one can never hold, and the policies API
  // refuses it as impossible; joined to another condition with `||`, that arm is
  // simply dead. Either way it protects nothing, not even the namespace holding the
  // table. To keep a table's grants out of reach, name the namespace it is in.
  //
  // To keep an object out of reach, forbid these actions at every root that reaches
  // it. Naming the warehouse covers all of them at once, and leaves the operations
  // available in every other warehouse:
  //
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantActions", resource)
  //   when { resource in Lakekeeper::Warehouse::"<warehouse id>" };
  //
  // To keep them available for the rest of that warehouse, name the roots one by one:
  // the warehouse, each namespace above the protected one, and the protected one
  // itself.
  //
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantActions", resource)
  //   when {
  //     resource == Lakekeeper::Warehouse::"<warehouse id>" ||
  //     resource == Lakekeeper::Namespace::"<each namespace above it>" ||
  //     resource in Lakekeeper::Namespace::"<the protected namespace>"
  //   };
  //
  // Both forms name roots that exist when the rule is written, and a move changes
  // which roots reach the object. Revisit the enumerated form whenever the protected
  // object or any namespace above it is moved: a namespace re-parented under a new
  // one puts a root the rule does not name above the object, and that root reaches
  // it. Revisit the warehouse form when a namespace is moved into another warehouse,
  // which carries the grants held inside it along. Neither move reports that a rule
  // has stopped covering what it was written for, so the warehouse form is the one to
  // prefer where the whole warehouse can be fenced.
  //
  // Note also that a condition which can only hold for a namespace leaves the
  // warehouse root open, and that root reaches everything in the warehouse. Name the
  // warehouse explicitly in any rule meant to cover it.
  //
  // Or keep these operations out of a deployment altogether by forbidding them with
  // no condition on the resource, which leaves per-object grant administration and
  // its own fences working as before.

  // How far one subtree operation reaches.
  //
  // A concrete call carries every member. `context.subtree` is absent altogether
  // when the question is whether the principal may run these operations here at
  // all, which is what the API listing your permissions on an object asks. Read
  // the record only behind a `has` guard:
  //
  //   when {
  //     context has subtree &&
  //     context.subtree.root_level == Lakekeeper::SubtreeRootLevel::"excluded"
  //   }
  //
  // A guard naming something this record omits — a misspelling, or a member from
  // an older release — reads false for every request. In a `when` that rests on it
  // alone, Lakekeeper rejects the policy as impossible; joined to another condition
  // with `||`, the misspelled arm is simply dead and the policy is accepted. In an
  // `unless`, the policy is accepted and the `forbid` applies to every request,
  // denying the operation outright. Spell member names with care, and take the
  // server's answer over `cedar validate`.
  //
  // Guard on `context has subtree` only in a rule headed at these four actions or
  // at `SubtreeGrantActions`. Under `GrantActions`, which also covers the
  // per-object grant actions, that guard is false for every one of them, so an
  // `unless` carrying it denies all grant administration.
  type SubtreeGrantScope = {
    // Every resource type the call reaches. Always at least one, and always a
    // subset of the types the root covers: a call naming none carries the full
    // set, so this states what the operation actually touches.
    //
    //   context.subtree.resource_types.contains(
    //     Lakekeeper::SubtreeResourceType::"table")
    resource_types: Set<SubtreeResourceType>,
    // Whether the root object's own grants are in reach, alongside everything
    // below it.
    root_level: SubtreeRootLevel,
    // Which privileges are in reach.
    privileges: SubtreeGrantPrivileges,
    // Whose grants are in reach.
    principal: SubtreeGrantPrincipal,
    // Whether the call only reports what it would do. A dry run reads the same
    // grants as the live call and changes nothing, so a policy can allow a
    // rehearsal and still refuse the revoke itself. A revoke makes two checks
    // and both carry the same value. A listing carries false.
    //
    //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantRevokeActions", resource)
    //   unless { context has subtree && context.subtree.dry_run };
    dry_run: Bool,
  };

  // Which privileges a subtree operation covers.
  //
  // `every` is true when the call reaches every privilege a matching grant can
  // carry, which is the form a call naming no privilege takes. It is the widest
  // form, and a revoke in that form clears grant administration along with
  // everything else — including the privilege that would let someone put the
  // grants back. To keep an administrative escape hatch standing:
  //
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantRevokeActions", resource)
  //   unless {
  //     context has subtree &&
  //     !context.subtree.privileges.every &&
  //     context.subtree.privileges has names &&
  //     !context.subtree.privileges.names.contains(
  //       Lakekeeper::SubtreeGrantPrivilege::"manage_grants")
  //   };
  //
  // Headed at the revokes, so listing stays available. Written as an `unless`,
  // it also covers the permission listing, so these scopes stop reporting a bulk
  // revoke as available.
  //
  // Test `every` in any rule about which privileges a call reaches. The widest
  // call carries no `names`, so a condition reading only `names` is false for it,
  // and a `forbid` written that way permits the very call it targets.
  //
  // When `every` is false the call names its privileges, and `names` holds them.
  // Each is a name this server publishes for a type the root covers; the API
  // refuses a call naming anything else. A grant recorded under a privilege this
  // server has since stopped publishing is reached by the `every` form.
  type SubtreeGrantPrivileges = {
    every: Bool,
    names?: Set<SubtreeGrantPrivilege>,
  };

  // A privilege a subtree call can name. Every privilege grantable on a type a
  // subtree call reaches, so a misspelling here is refused when the policy is
  // written. `unknown` is absent on purpose: the API refuses a call naming a
  // privilege outside this vocabulary, so it can never arrive.
  entity SubtreeGrantPrivilege enum
    ["describe", "select", "write", "create", "manage", "manage_policies",
     "pass_grants", "manage_grants"];

  // Whose grants a subtree operation covers: every principal holding one, or a
  // single named principal.
  //
  // `every` is always set when this record is present. It is true for the widest
  // form of these operations, and false when the call names one principal.
  //
  // A call naming one principal usually carries exactly one of `user` and `role`,
  // but it carries neither when the named role belongs to no role this project
  // holds — there is no entity to name it by. Such a call reaches no grant, and the
  // server answers it `404` once the decision has been taken, so a rule reading
  // `role` behind the `has` guard simply does not match it.
  //
  // That last point matters for a rule that has to hold whatever a call names. A
  // `forbid` written as `when { ... has role && ... }` states which calls it stops,
  // so it lets this one through. Write the rule as an `unless` stating which calls
  // it lets through, and it stops every other one, this case included:
  //
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantRevokeActions", resource)
  //   unless {
  //     context has subtree &&
  //     (context.subtree.principal has user || context.subtree.principal has role)
  //   };
  //
  // Guard with `has` before reading either member, and test `every` in any rule
  // about a named principal: the widest call names nobody, so a condition reading
  // only `user` or `role` is false for it as well.
  //
  // A `user` names an identity the server need hold no record of: a user id holds
  // grants without one. Match a user by its entity id; the roles a rule reaches
  // through it are the ones the server can resolve, which for an unknown id is
  // none.
  //
  // Both are entities, like `context.grantee` on the `ManageXGrants` actions, so
  // a rule can follow one with `in` and cover every role nested inside a role:
  //
  //   when {
  //     context has subtree &&
  //     context.subtree.principal has role &&
  //     context.subtree.principal.role in Lakekeeper::Role::"prod/oidc~admins"
  //   }
  //
  // To forbid the widest calls:
  //
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantActions", resource)
  //   when { context has subtree && context.subtree.principal.every };
  //
  // That reaches real calls only: the permission listing carries no `subtree`, so
  // the guard reads false there and the listing keeps reporting the operation as
  // available. To withdraw that offer as well, forbid everything except a call
  // naming a single principal:
  //
  //   forbid (principal, action in Lakekeeper::Action::"SubtreeGrantActions", resource)
  //   unless { context has subtree && !context.subtree.principal.every };
  type SubtreeGrantPrincipal = {
    every: Bool,
    user?: User,
    role?: Role,
  };

  // Whether the root object's own grants are in reach: `"included"` when the call
  // reaches the warehouse or namespace it names as well as everything below it,
  // `"excluded"` when it reaches only what is below. `resource_types` can still
  // exclude the root's own type.
  entity SubtreeRootLevel enum ["included", "excluded"];

  // A resource type, spelled as the grants API spells it. A warehouse-rooted call
  // that includes its root level reaches `warehouse`, `namespace`, `table`, `view`
  // and `generic-table`; with the root level excluded, and for every
  // namespace-rooted call, the same set without `warehouse`. The enum also carries
  // `server`, `project` and `tag-definition` to match the grants API, and a
  // condition naming one of those matches nothing.
  entity SubtreeResourceType enum
    ["server", "project", "warehouse", "namespace", "table", "view",
     "generic-table", "tag-definition"];

  action "SubtreeGrantActions" in ["GrantActions"];
  action "SubtreeGrantReadActions" in ["SubtreeGrantActions", "GrantReadActions"];
  action "SubtreeGrantRevokeActions" in ["SubtreeGrantActions"];

  action ReadWarehouseSubtreeGrants in ["SubtreeGrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse],
      context: {
        // What this listing covers; see `SubtreeGrantScope` above.
        subtree?: SubtreeGrantScope,
      }
    };
  action RevokeWarehouseSubtreeGrants in ["SubtreeGrantRevokeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse],
      context: {
        // What this revoke covers; see `SubtreeGrantScope` above.
        subtree?: SubtreeGrantScope,
      }
    };

  action ReadNamespaceSubtreeGrants in ["SubtreeGrantReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // What this listing covers; see `SubtreeGrantScope` above.
        subtree?: SubtreeGrantScope,
      }
    };
  action RevokeNamespaceSubtreeGrants in ["SubtreeGrantRevokeActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Namespace],
      context: {
        // What this revoke covers; see `SubtreeGrantScope` above.
        subtree?: SubtreeGrantScope,
      }
    };

  // ---------- Cedar Policy Actions ----------
  // Cedar policies decide every other action in this schema, so whoever may
  // rewrite them can decide their own access one request later. Like grant
  // administration above, these actions stand outside the per-resource
  // `<X>Actions` groups: reading or writing a scope's policies takes a policy
  // that names one of the groups below.
  //
  //   CedarPolicyActions     — every policy-administration action, every level.
  //   CedarPolicyReadActions — the read-only subset, across every level.
  //   XCedarPolicyActions    — reading and writing policies on one level.
  //
  // Server-level policies come from the server's own policy sources (files,
  // Kubernetes ConfigMaps); the API reads them only.
  //
  // The `manage_policies` privilege maps to `ProjectCedarPolicyActions` and
  // `WarehouseCedarPolicyActions`. The server level is reachable from a server
  // policy alone: name `ServerCedarPolicyActions` or its individual actions.
  action "CedarPolicyActions";
  action "CedarPolicyReadActions" in ["CedarPolicyActions"];

  // Reading where the server gets its policies and entities from, and what
  // those sources currently provide.
  //
  //   EvaluateCedarPolicies — try a policy out against the engine without
  //     saving it. Reserved for a future endpoint.
  action "ServerCedarPolicyActions" in ["CedarPolicyActions"];
  action ListServerCedarPolicySources, ListServerCedarEntitySources,
         ListCedarPoliciesFromServerSources, EvaluateCedarPolicies
      in ["ServerCedarPolicyActions", "CedarPolicyReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Server]
    };

  action "ProjectCedarPolicyActions" in ["CedarPolicyActions"];
  action ListProjectCedarPolicies, GetProjectCedarPolicy
      in ["ProjectCedarPolicyActions", "CedarPolicyReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };
  action ApplyProjectCedarPolicies in ["ProjectCedarPolicyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };
  // Switching one predefined policy on or off for this project. Asked once per
  // policy in the request, so a policy of yours can decide each one on its own:
  //
  //   when { context.enabled == false }      // may switch off, never on
  //   when { context.policy_id like "predefined-grants-table-*" }
  //
  action ToggleProjectPredefinedPolicy in ["ProjectCedarPolicyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project],
      context: {
        // The policy being switched, e.g. "predefined-grants-table-select".
        policy_id: String,
        // What it is being switched to: true turns the policy on.
        enabled: Bool,
      }
    };
  // Dropping every predefined-policy decision this project has recorded, putting
  // it back on the shipped defaults in one step.
  action ResetProjectPredefinedPolicies in ["ProjectCedarPolicyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Project]
    };

  // This group holds the policy actions alone. Every warehouse route asks
  // `UseWarehouse` first and answers "not found" when it is denied, so a policy
  // permitting this group names `UseWarehouse` too where it wants those routes
  // reachable — the shipped `manage_policies` policy does. Keeping the probe out
  // of the group also keeps a blanket `forbid` on `CedarPolicyActions` from
  // hiding every warehouse.
  action "WarehouseCedarPolicyActions" in ["CedarPolicyActions"];
  action ListWarehouseCedarPolicies, GetWarehouseCedarPolicy
      in ["WarehouseCedarPolicyActions", "CedarPolicyReadActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse]
    };
  action ApplyWarehouseCedarPolicies in ["WarehouseCedarPolicyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse]
    };
  // Switching one predefined policy on or off for this warehouse. Asked once per
  // policy in the request, so a policy of yours can decide each one on its own:
  //
  //   when { context.enabled == false }      // may switch off, never on
  //   when { context.policy_id like "predefined-grants-table-*" }
  //
  action ToggleWarehousePredefinedPolicy in ["WarehouseCedarPolicyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse],
      context: {
        // The policy being switched, e.g. "predefined-grants-table-select".
        policy_id: String,
        // What it is being switched to: true turns the policy on.
        enabled: Bool,
      }
    };
  // Dropping every predefined-policy decision this warehouse has recorded, putting
  // it back on the shipped defaults in one step.
  action ResetWarehousePredefinedPolicies in ["WarehouseCedarPolicyActions"]
    appliesTo {
      principal: [User, Role],
      resource: [Warehouse]
    };
}
