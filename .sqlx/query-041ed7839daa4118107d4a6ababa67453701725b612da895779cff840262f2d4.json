  "query": "\n                UPDATE task_schedule\n                SET interval_seconds = $2,\n                    anchor = $3,\n                    payload = COALESCE($4, payload),\n                    enabled = COALESCE($5, enabled),\n                    next_run_at = $6,\n                    spec_version = $7\n                WHERE schedule_id = $1\n                RETURNING\n                    schedule_id,\n                    project_id,\n                    warehouse_id,\n                    queue_name,\n                    schedule_key,\n                    interval_seconds,\n                    anchor,\n                    payload,\n                    enabled,\n                    next_run_at,\n                    missed_runs,\n                    created_at,\n                    updated_at\n                ",
