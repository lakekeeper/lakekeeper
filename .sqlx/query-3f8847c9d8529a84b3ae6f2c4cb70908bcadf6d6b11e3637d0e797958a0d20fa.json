{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            schedule_id,\n            project_id,\n            warehouse_id,\n            queue_name,\n            schedule_key,\n            interval_seconds,\n            anchor,\n            payload,\n            enabled,\n            next_run_at,\n            missed_runs,\n            created_at,\n            updated_at\n        FROM task_schedule\n        WHERE project_id = $1\n            AND ($2::uuid IS NULL OR warehouse_id = $2)\n            AND ($3::text IS NULL OR queue_name = $3)\n            AND ($4::text IS NULL OR schedule_key = $4)\n            AND spec_version <= $5\n        ORDER BY schedule_id\n        ",
