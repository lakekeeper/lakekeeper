{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            tag_id,\n            tag_definition_id,\n            value,\n            source AS \"source: TagSource\",\n            created_at,\n            updated_at\n        FROM tag\n        WHERE warehouse_id = $1\n          AND namespace_id IS NOT DISTINCT FROM $2\n          AND tabular_id IS NOT DISTINCT FROM $3\n          AND field_id IS NOT DISTINCT FROM $4\n        ORDER BY created_at, tag_id\n        ",
