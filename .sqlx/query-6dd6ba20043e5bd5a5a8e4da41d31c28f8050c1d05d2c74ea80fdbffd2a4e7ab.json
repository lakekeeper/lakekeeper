  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO task_schedule (\n                schedule_id,\n                project_id,\n                warehouse_id,\n                queue_name,\n                schedule_key,\n                interval_seconds,\n                anchor,\n                payload,\n                enabled,\n                next_run_at,\n                spec_version\n            )\n            VALUES (\n                task_schedule_id($1, $2, $3, $4),\n                $1, $2, $3, $4, $5, $6,\n                COALESCE($7, '{}'::jsonb),\n                COALESCE($8, true),\n                $9,\n                $10\n            )\n            ON CONFLICT (schedule_id) DO NOTHING\n            RETURNING\n                schedule_id,\n                project_id,\n                warehouse_id,\n                queue_name,\n                schedule_key,\n                interval_seconds,\n                anchor,\n                payload,\n                enabled,\n                next_run_at,\n                missed_runs,\n                created_at,\n                updated_at\n            ",
