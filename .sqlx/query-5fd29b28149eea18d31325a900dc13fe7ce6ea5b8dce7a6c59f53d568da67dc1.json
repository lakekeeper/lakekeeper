{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.queue_name AS \"queue_name!\",\n            COUNT(*) FILTER (WHERE t.status = 'scheduled') AS \"scheduled_total!\",\n            COUNT(*) FILTER (WHERE t.status IN ('running', 'should-stop')) AS \"running_raw!\"\n        FROM task t\n        WHERE t.queue_name = ANY($1)\n        GROUP BY t.queue_name\n        ",
