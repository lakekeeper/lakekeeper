{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit records emitted by lakekeeper",
  "x-audit-emitter": {
    "name": "lakekeeper",
    "format": "1.0"
  },
  "$defs": {
    "ActionContextKey": {
      "type": "string",
      "enum": [
        "allow-partial",
        "base_location",
        "created-before",
        "deletes",
        "destination",
        "dry-run",
        "force",
        "format",
        "generic_table_id",
        "name",
        "narrowed_privileges",
        "principal",
        "principals",
        "privilege_scope",
        "privileges",
        "project_id",
        "properties",
        "purge",
        "recursive",
        "removed-properties",
        "requested_provider_id",
        "requested_source_id",
        "resource_types",
        "root_level",
        "source",
        "table_id",
        "target-refs",
        "update-kinds",
        "updated-properties",
        "writes"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action-key",
      "x-audit-type": "lakekeeper::service::events::context::ActionContextKey"
    },
    "ActionRecord": {
      "type": "object",
      "properties": {
        "action_name": {
          "type": "string",
          "description": "The action's wire name, from a vocabulary enum of any emitter."
        }
      },
      "required": [
        "action_name"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/ContextValue"
      },
      "description": "An `action` object: the wire name and the action's context fields.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::ActionRecord"
    },
    "ActorRecord": {
      "type": "object",
      "properties": {
        "actor_type": {
          "type": "string",
          "description": "One of `anonymous`, `principal`, `assumed-role`, `lakekeeper-internal`."
        },
        "principal": {
          "type": [
            "string",
            "null"
          ],
          "description": "The authenticated principal. Present for `principal` and `assumed-role`."
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "description": "Best-effort email of `principal`. Present only when the operator enabled it and one\nwas available. Metadata, not identity: correlate on `principal`."
        },
        "assumed_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssumedRoleRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "The role acted as. Present for `assumed-role`; `principal` is still the human."
        }
      },
      "required": [
        "actor_type"
      ],
      "description": "The `actor` object: who made the request, as authentication established it.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::ActorRecord"
    },
    "ActorType": {
      "type": "string",
      "enum": [
        "anonymous",
        "assumed-role",
        "lakekeeper-internal",
        "principal"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "actor_type",
      "x-audit-type": "lakekeeper::service::events::backends::audit::ActorType"
    },
    "AdmissionRejectedContext": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "string",
          "description": "The gate that rejected the request."
        },
        "denied_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "The rule of the gate that decided, when the gate names one."
        },
        "status": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "The HTTP status the caller received."
        },
        "error_type": {
          "type": "string",
          "description": "The error type the caller received."
        },
        "message": {
          "type": "string",
          "description": "The gate's own wording. Suppressing the error-response line takes this\nwith it, and it is what separates two rejections that share a type —\na gate failing closed on a missing precondition from the same gate\nfailing closed on an unreachable upstream."
        },
        "error_id": {
          "type": "string",
          "description": "The id the caller can quote to correlate with this record."
        },
        "request_id": {
          "type": "string",
          "description": "The request this rejection belongs to, repeated out of the span so the record stands\nalone."
        }
      },
      "required": [
        "gate",
        "status",
        "error_type",
        "message",
        "error_id",
        "request_id"
      ],
      "description": "Context for the admission-rejection audit record.\n\nThe operation-specific fields live here rather than at the top level,\nbecause that is the shape every `event_source=\"audit\"` operational record\npromises. `error_id` correlates with what the caller was handed, and\n`request_id` is repeated out of the span so the record stands alone.",
      "x-audit-kind": "context",
      "x-audit-type": "lakekeeper::service::admission::AdmissionRejectedContext<'_>"
    },
    "AssignmentAction": {
      "type": "string",
      "enum": [
        "update_generic_table_assignments",
        "update_namespace_assignments",
        "update_project_assignments",
        "update_role_assignments",
        "update_server_assignments",
        "update_table_assignments",
        "update_tag_assignments",
        "update_view_assignments",
        "update_warehouse_assignments"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper_authz_openfga::api::AssignmentAction"
    },
    "AssumedRoleRecord": {
      "type": "object",
      "properties": {
        "role_id": {
          "type": "string",
          "description": "The role's id in this catalog."
        },
        "provider_id": {
          "type": "string",
          "description": "The provider that supplied the role."
        },
        "source_id": {
          "type": "string",
          "description": "The role's id at the provider."
        }
      },
      "required": [
        "role_id",
        "provider_id",
        "source_id"
      ],
      "description": "The role an `assumed-role` actor acts as.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::AssumedRoleRecord"
    },
    "AuditOperation": {
      "type": "string",
      "enum": [
        "admission_decided",
        "grant_created",
        "grant_revoked",
        "idempotent_replay"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "operation",
      "x-audit-type": "lakekeeper::service::events::backends::audit::AuditOperation"
    },
    "AuditOutcome": {
      "type": "string",
      "enum": [
        "forbidden",
        "replayed",
        "success",
        "unavailable"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "outcome",
      "x-audit-type": "lakekeeper::service::events::backends::audit::AuditOutcome"
    },
    "AuthnAction": {
      "type": "string",
      "enum": [
        "assume_role"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::events::context::AuthnAction"
    },
    "AuthorizationFailureReason": {
      "type": "string",
      "enum": [
        "ActionForbidden",
        "CannotSeeResource",
        "InternalAuthorizationError",
        "InternalCatalogError",
        "InvalidRequestData",
        "ResourceNotFound"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "failure_reason",
      "x-audit-type": "lakekeeper::service::events::types::authorization::AuthorizationFailureReason"
    },
    "CatalogGenericTableAction": {
      "type": "string",
      "enum": [
        "control_tasks",
        "drop",
        "get_metadata",
        "get_tasks",
        "include_in_list",
        "manage_tags",
        "read_data",
        "read_grants",
        "rename",
        "set_protection",
        "undrop",
        "write_data"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogGenericTableAction"
    },
    "CatalogNamespaceAction": {
      "type": "string",
      "enum": [
        "accept_moved_namespace",
        "create_generic_table",
        "create_namespace",
        "create_table",
        "create_view",
        "delete",
        "get_metadata",
        "include_in_list",
        "list_everything",
        "list_generic_tables",
        "list_namespaces",
        "list_tables",
        "list_views",
        "manage_tags",
        "move",
        "read_grants",
        "read_subtree_grants",
        "revoke_subtree_grants",
        "set_protection",
        "update_properties"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogNamespaceAction"
    },
    "CatalogProjectAction": {
      "type": "string",
      "enum": [
        "control_project_tasks",
        "create_role",
        "create_tag",
        "create_warehouse",
        "delete",
        "get_endpoint_statistics",
        "get_metadata",
        "get_project_tasks",
        "get_task_queue_config",
        "include_in_list",
        "list_roles",
        "list_tags",
        "list_warehouses",
        "modify_task_queue_config",
        "read_grants",
        "rename",
        "search_roles"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogProjectAction"
    },
    "CatalogRoleAction": {
      "type": "string",
      "enum": [
        "delete",
        "manage_role_assignments",
        "read",
        "read_metadata",
        "read_role_assignments",
        "update",
        "update_source_system"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogRoleAction"
    },
    "CatalogServerAction": {
      "type": "string",
      "enum": [
        "create_project",
        "delete_users",
        "list_users",
        "provision_users",
        "read_grants",
        "update_users"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogServerAction"
    },
    "CatalogTableAction": {
      "type": "string",
      "enum": [
        "commit",
        "control_tasks",
        "drop",
        "get_metadata",
        "get_tasks",
        "include_in_list",
        "manage_tags",
        "read_data",
        "read_grants",
        "rename",
        "set_protection",
        "undrop",
        "write_data"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogTableAction"
    },
    "CatalogTagAction": {
      "type": "string",
      "enum": [
        "apply",
        "delete",
        "read",
        "read_attachments",
        "read_grants",
        "remove",
        "update"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogTagAction"
    },
    "CatalogUserAction": {
      "type": "string",
      "enum": [
        "delete",
        "read",
        "read_role_assignments",
        "update"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogUserAction"
    },
    "CatalogViewAction": {
      "type": "string",
      "enum": [
        "commit",
        "control_tasks",
        "drop",
        "get_metadata",
        "get_tasks",
        "include_in_list",
        "manage_tags",
        "read_grants",
        "rename",
        "select",
        "set_protection",
        "undrop"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogViewAction"
    },
    "CatalogWarehouseAction": {
      "type": "string",
      "enum": [
        "accept_moved_namespace",
        "activate",
        "control_all_tasks",
        "create_namespace",
        "deactivate",
        "delete",
        "get_all_tasks",
        "get_config",
        "get_endpoint_statistics",
        "get_metadata",
        "get_task_queue_config",
        "include_in_list",
        "list_deleted_tabulars",
        "list_everything",
        "list_namespaces",
        "manage_tags",
        "modify_soft_deletion",
        "modify_task_queue_config",
        "read_grants",
        "read_subtree_grants",
        "rename",
        "revoke_subtree_grants",
        "set_format_version_policy",
        "set_protection",
        "update_storage",
        "use"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::authz::CatalogWarehouseAction"
    },
    "ContextValue": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "A set of key-value pairs (e.g. properties, `updated_properties`)."
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of plain strings (e.g. `removed_properties`)."
        },
        {
          "type": "string",
          "description": "A single string value (e.g. resource name, ID)."
        }
      ],
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::authz::ContextValue"
    },
    "Decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "decision",
      "x-audit-type": "lakekeeper::service::events::backends::audit::Decision"
    },
    "DecisionRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The client's id for this check in a batch, or its index. Absent for single checks."
        },
        "for-principal": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "The principal whose permission was evaluated, when it is not the request's actor."
        },
        "action": {
          "$ref": "#/$defs/ActionRecord",
          "description": "The action evaluated."
        },
        "entity": {
          "$ref": "#/$defs/EntityRecord",
          "description": "The entity the action was evaluated against."
        },
        "allowed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "The authorizer's answer. Absent when an upstream error stopped the evaluation."
        },
        "determined_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeterminingFactor"
          },
          "description": "The policies or rules that determined the decision, when the authorizer reports them.\nThe same shape the management API returns for a check, so one parser reads both."
        }
      },
      "required": [
        "action",
        "entity"
      ],
      "description": "One entry of `authorizations[]`: which action on which entity was evaluated, for whom,\nwith what result.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::DecisionRecord"
    },
    "DeterminingFactor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy-id": {
              "type": "string",
              "description": "Stable, authorizer-assigned identifier of the policy (e.g. the Cedar\n`PolicyId`). Always present."
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Human-facing name the author gave the policy (e.g. a `@name` or\n`@id` annotation). Neither required nor guaranteed unique; absent\nwhen the author provided none."
            },
            "effect": {
              "$ref": "#/$defs/PolicyEffect",
              "description": "Whether the policy permits or forbids."
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "Opaque origin of the policy (e.g. a policy-source identifier).\nAbsent when the authorizer cannot attribute a source."
            },
            "type": {
              "type": "string",
              "const": "policy"
            }
          },
          "required": [
            "type",
            "policy-id",
            "effect"
          ],
          "description": "A policy that determined the decision, surfaced by a policy-based\nauthorizer."
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "Opaque, authorizer-assigned identifier of the built-in authority\ntier that granted the action. Absent when none can be attributed."
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "Human-facing reason the tier applied (e.g. an administrator\nlockout-recovery grant). Absent when the authorizer gives none."
            },
            "type": {
              "type": "string",
              "const": "system-authority"
            }
          },
          "required": [
            "type"
          ],
          "description": "An allow contributed by a built-in/system authority tier that takes\nprecedence over normal authored policy — e.g. a recovery mechanism that\nlets a privileged system role act despite a policy that would otherwise\nforbid it. Its presence means the verdict rested on built-in authority\nrather than on a configured policy."
        }
      ],
      "description": "A single factor that contributed to an authorization decision.\n\nDiscriminated by `type`: `policy` names a policy the authorizer matched, and\n`system-authority` records that a built-in authority tier decided the request. The\nschema is a closed `oneOf` over those two, so a further kind is a schema change a\ngenerated client has to be rebuilt for rather than one it absorbs on its own."
    },
    "EmitterRecord": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The emitter's name, unique across the products that write to this log."
        },
        "format": {
          "type": "string",
          "description": "The `MAJOR.MINOR` version of what this emitter contributes."
        }
      },
      "required": [
        "name",
        "format"
      ],
      "description": "The `emitter` object: which product produced this record, and the version of the\nvocabulary and context shapes it governs.\n\nA consumer routes the core shape on `audit_format` and everything the emitter owns — its\n`context`, its vocabulary, any shape it defines — on this.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::EmitterRecord"
    },
    "EntityField": {
      "type": "string",
      "enum": [
        "generic-table",
        "generic-table-id",
        "namespace",
        "namespace-id",
        "project-id",
        "role-id",
        "role-provider-id",
        "role-source-id",
        "server-id",
        "table",
        "table-id",
        "table-location",
        "tag-definition-id",
        "task-id",
        "user-id",
        "view",
        "view-id",
        "warehouse-id"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "entity-key",
      "x-audit-type": "lakekeeper::service::events::context::EntityField"
    },
    "EntityRecord": {
      "type": "object",
      "properties": {
        "entity_type": {
          "type": "string",
          "description": "The kind of resource: `table`, `namespace`, `warehouse`, …"
        }
      },
      "required": [
        "entity_type"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "An `entity` object: the kind of resource and its identifying fields.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::EntityRecord"
    },
    "EntityType": {
      "type": "string",
      "enum": [
        "generic-table",
        "namespace",
        "project",
        "role",
        "server",
        "table",
        "tag",
        "task",
        "unknown",
        "user",
        "view",
        "warehouse"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "entity_type",
      "x-audit-type": "lakekeeper::service::events::context::EntityType"
    },
    "ErrorRecord": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "The error type the caller received."
        },
        "code": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "The HTTP status the caller received."
        },
        "message": {
          "type": "string",
          "description": "The error message the caller received."
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The error's stack of causes, innermost first. Absent when empty."
        },
        "error_id": {
          "type": "string",
          "description": "The id the caller can quote to correlate with this record."
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "error_id"
      ],
      "description": "The `error` object of a denied authorization record.",
      "x-audit-kind": "part",
      "x-audit-type": "lakekeeper::service::events::backends::audit::parts::ErrorRecord"
    },
    "FallbackAction": {
      "type": "string",
      "enum": [
        "unknown"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper::service::events::context::FallbackAction"
    },
    "GenericTableRelation": {
      "type": "string",
      "enum": [
        "can_change_ownership",
        "can_control_tasks",
        "can_drop",
        "can_get_metadata",
        "can_get_tasks",
        "can_grant_describe",
        "can_grant_manage_grants",
        "can_grant_manage_tags",
        "can_grant_modify",
        "can_grant_pass_grants",
        "can_grant_select",
        "can_include_in_list",
        "can_manage_tags",
        "can_read_assignments",
        "can_read_data",
        "can_rename",
        "can_revoke_describe",
        "can_revoke_modify",
        "can_revoke_select",
        "can_set_protection",
        "can_undrop",
        "can_write_data",
        "describe",
        "manage_grants",
        "manage_tags",
        "modify",
        "ownership",
        "parent",
        "pass_grants",
        "select"
      ],
      "x-audit-kind": "enum",
      "x-audit-field": "action_name",
      "x-audit-type": "lakekeeper_authz_openfga::relations::GenericTableRelation"
    },
    "GrantContextRecord": {
      "type": "object",
      "properties": {
        "principal": {
          "$ref": "#/$defs/SubjectRecord",
          "description": "Who holds the grant."
        },
        "privilege": {
          "type": "string",
          "description": "The privilege name, verbatim from the authorizer's vocabulary."
        },
        "resource_type": {
          "type": "string",
          "description": "The kind of resource the grant is on."
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exact resource. Absent for server grants, whose type is their whole identity."
        },
        "warehouse_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The containing warehouse, for warehouse-scoped resources."
        }
      },
      "required": [
        "principal",
