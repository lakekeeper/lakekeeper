module lakekeeper-warehouse

type warehouse
  relations
    # ------------------ Relation Hierarchies ------------------
    define project: [project]
    define namespace: [namespace]

    # ------------------ Special roles ------------------
    define ownership: [user, role#assignee]
    define managed_access: [user:*, role:*]
    define managed_access_inheritance: managed_access

    # ------------------ Assignable Privileges ------------------
    define pass_grants: [user, role#assignee]
    define manage_grants: [user, role#assignee] or ownership or security_admin from project
    # Each privilege is two relations: the bare name is what was granted on this
    # warehouse, and grants are written to and listed from it; the `_effective`
    # twin adds the weaker privileges it subsumes and what flows down from the
    # project. Actions read the `_effective` twin.
    define describe: [user, role#assignee]
    define describe_effective: describe or ownership or select_effective or create_effective or describe_effective from project
    define select: [user, role#assignee]
    define select_effective: select or ownership or modify_effective or select_effective from project
    define create: [user, role#assignee]
    define create_effective: create or ownership or create_effective from project
    define modify: [user, role#assignee]
    define modify_effective: modify or ownership or modify_effective from project or data_admin from project

    # ------------------ Visibility ------------------
    # True when this principal holds a grant on this warehouse or anywhere below it.
    # Each object contributes only its own stored tuples and the recursion runs
    # downward, so a descendant never re-asks the question of its parent: what it
    # inherits from above is already answered by `describe_effective` here.
    define visible_below: describe or select or create or modify or ownership or visible_below from namespace
    # Governance tag attachment. Independent of `modify` (separation of duties:
    # classify without holding data/DDL rights); security_admin governs.
    define manage_tags: [user, role#assignee] or security_admin from project

    # ------------------ Actions ------------------
    define can_create_namespace: create_effective
    define can_accept_moved_namespace: manage_grants and create_effective
    # Delete this warehouse permanently
    define can_delete: modify_effective
    define can_update_storage: modify_effective
    define can_update_storage_credential: modify_effective
    define can_get_metadata: describe_effective or visible_below from namespace
    define can_get_config: can_get_metadata
    define can_set_protection: modify_effective
    define can_set_format_version_policy: modify_effective
    define can_manage_tags: manage_tags
    # Can list elements in this warehouse - will be filtered subsequently
    define can_list_namespaces: can_get_metadata
    define can_list_everything: describe_effective
    define can_use: can_get_metadata
    define can_include_in_list: can_get_metadata
    define can_deactivate: modify_effective
    define can_activate: modify_effective
    define can_rename: modify_effective
    define can_list_deleted_tabulars: can_get_metadata
    define can_modify_soft_deletion: modify_effective
    define can_get_endpoint_statistics: describe_effective
    # Task permissions
    define can_get_all_tasks: describe_effective
    define can_control_all_tasks: modify_effective
    # Only if we can GRANT a privilege, we can LIST them for now
    define can_read_assignments: can_grant_create or can_grant_describe or can_grant_modify or can_grant_select or can_grant_pass_grants or can_grant_manage_grants or can_grant_manage_tags or can_change_ownership
    # Reading every grant in the warehouse is administration-grade; see the namespace twin.
    define can_read_subtree_assignments: manage_grants
    define can_revoke_subtree_assignments: manage_grants
    # Task Queue Configurations
    define can_get_task_queue_config: can_get_metadata
    define can_modify_task_queue_config: modify_effective
    # GRANT Permissions
    define can_grant_create: manage_grants or (create_effective and pass_grants)
    define can_grant_describe: manage_grants or (describe_effective and pass_grants)
    define can_grant_modify: manage_grants or (modify_effective and pass_grants)
    define can_grant_select: manage_grants or (select_effective and pass_grants)
    define can_grant_pass_grants: manage_grants
    define can_grant_manage_grants: manage_grants
    define can_grant_manage_tags: manage_grants

    # REVOKE Permissions
    # Taking a privilege back is administration, never delegation
    define can_revoke_create: manage_grants
    define can_revoke_describe: manage_grants
    define can_revoke_modify: manage_grants
    define can_revoke_select: manage_grants
    define can_change_ownership: manage_grants
    define can_set_managed_access: manage_grants
