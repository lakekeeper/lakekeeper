module lakekeeper-namespace

type namespace
  relations
    # ------------------ Relation Hierarchies ------------------
    define parent: [namespace, warehouse]
    define child: [namespace, lakekeeper_table, lakekeeper_view, lakekeeper_generic_table]

    # ------------------ Special roles ------------------
    define ownership: [user, role#assignee]
    define managed_access: [user:*, role:*]
    define managed_access_inheritance: managed_access or managed_access_inheritance from parent

    # ------------------ Assignable Privileges ------------------
    define pass_grants: [user, role#assignee]
    define manage_grants: [user, role#assignee] or (ownership but not managed_access_inheritance from parent) or manage_grants from parent
    # Split as on the warehouse: the bare name is what was granted here, the
    # `_effective` twin adds what it implies and what flows down from the parent.
    define describe: [user, role#assignee]
    define describe_effective: describe or ownership or select_effective or create_effective or describe_effective from parent
    define select: [user, role#assignee]
    define select_effective: select or ownership or modify_effective or select_effective from parent
    define create: [user, role#assignee]
    define create_effective: create or ownership or create_effective from parent
    define modify: [user, role#assignee]
    define modify_effective: modify or ownership or modify_effective from parent

    # ------------------ Visibility ------------------
    # A grant on this namespace or anywhere below it. Each object contributes only
    # its own stored tuples and the recursion runs downward; see warehouse.fga.
    define visible_below: describe or select or create or modify or ownership or visible_below from child
    # Governance tag attachment. Independent of `modify` (separation of duties);
    # inherits down the resource tree, so warehouse/project grants flow in.
    define manage_tags: [user, role#assignee] or manage_tags from parent

    # ------------------ Actions ------------------
    define can_create_table: create_effective
    define can_create_view: create_effective
    define can_create_generic_table: create_effective
    define can_create_namespace: create_effective
    define can_accept_moved_namespace: manage_grants and create_effective
    define can_delete: modify_effective
    define can_move: manage_grants and modify_effective
    define can_update_properties: modify_effective
    define can_get_metadata: describe_effective or visible_below from child
    define can_list_tables: can_get_metadata
    define can_list_views: can_get_metadata
    define can_list_generic_tables: can_get_metadata
    define can_list_namespaces: can_get_metadata
    define can_list_everything: describe_effective
    define can_include_in_list: can_get_metadata
    define can_read_assignments: can_grant_create or can_grant_describe or can_grant_modify or can_grant_select or can_grant_pass_grants or can_grant_manage_grants or can_grant_manage_tags or can_change_ownership
    # Reading every grant in the subtree is administration-grade: manage_grants is the
    # relation whose reach is the subtree (it inherits via parent), so it is the floor.
    define can_read_subtree_assignments: manage_grants
    define can_revoke_subtree_assignments: manage_grants
    define can_set_protection: modify_effective
    define can_manage_tags: manage_tags
    # GRANT Permissions
    define can_grant_create: manage_grants or (create_effective and pass_grants)
    define can_grant_describe: manage_grants or (describe_effective and pass_grants)
    define can_grant_modify: manage_grants or (modify_effective and pass_grants)
    define can_grant_select: manage_grants or (select_effective and pass_grants)
    define can_grant_pass_grants: manage_grants
    define can_grant_manage_grants: manage_grants
    define can_grant_manage_tags: manage_grants

    # REVOKE Permissions
    # Taking a privilege back is administration, never delegation
    define can_revoke_create: manage_grants
    define can_revoke_describe: manage_grants
    define can_revoke_modify: manage_grants
    define can_revoke_select: manage_grants
    define can_change_ownership: manage_grants
    define can_set_managed_access: manage_grants
