module lakekeeper-catalog-tag

# A governance tag *definition* — one instance per definition, parented to the
# project that owns the tag vocabulary. Distinct from an Iceberg snapshot tag.
type lakekeeper_catalog_tag
  relations
    # ------------------ Relation Hierarchies ------------------
    define project: [project]

    # ------------------ Special roles ------------------
    define ownership: [user, role#assignee]

    # ------------------ Assignable Privileges ------------------
    # "May attach/detach THIS tag." The per-tag delegation point: grant it to a
    # steward/role without granting definition ownership. Applying to a resource
    # additionally requires can_manage_tags on that resource (checked separately).
    define apply: [user, role#assignee] or ownership or security_admin from project

    # ------------------ Actions ------------------
    # Read the definition. Whoever can list tags in the project reads every
    # definition; owners/appliers can read the ones they hold (via `apply`).
    define can_read: can_list_tags from project or apply
    define can_update: ownership or security_admin from project
    define can_delete: ownership or security_admin from project
    # Attach AND detach carry the same tag-side gate — stripping a governance tag
    # must not be possible with target rights alone.
    define can_apply: apply
    # GRANT Permissions
    define can_grant_apply: ownership or security_admin from project
    define can_change_ownership: ownership or security_admin from project
    define can_read_assignments: can_grant_apply or can_change_ownership
